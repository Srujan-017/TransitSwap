name: Keep backend warm

# The free Render host puts the backend to sleep after about 15 minutes without a request, and the first request afterwards
# takes about 30 seconds (measured: 33 s). That is the worst thing that can happen during a demonstration, so this asks for
# the health page every 10 minutes. It only reads /api/health; nothing is written. Delete this file to stop it, or run it by
# hand from the Actions tab before a demonstration.

on:
  schedule:
    - cron: "*/10 * * * *"
  workflow_dispatch:

jobs:
  ping:
    runs-on: ubuntu-latest
    steps:
      - name: Ask the backend for its health page
        run: |
          curl --silent --show-error --max-time 90 --retry 2 --output /dev/null --write-out "health: %{http_code} in %{time_total}s\n" \
            "${{ vars.DEPLOYED_BACKEND_URL || 'https://transitswap-backend.onrender.com' }}/api/health"
