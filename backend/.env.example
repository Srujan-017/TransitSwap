# TransitSwap Backend — Environment Configuration
# Copy this file to .env and fill in your values.
# All variables marked [OPTIONAL] will fall back to demo/mock data if not provided.

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=5000

# ── MongoDB ────────────────────────────────────────────────────────────────────
# [OPTIONAL] If not provided, the app will run fully offline using demo data.
MONGODB_URI=mongodb://localhost:27017/transitswap

# ── JSON Web Token ─────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# ── OpenWeatherMap API ─────────────────────────────────────────────────────────
# [OPTIONAL] Free tier key from https://openweathermap.org/api
# If omitted, the platform uses deterministic demo weather (clearly labelled "Demo").
OPENWEATHER_API_KEY=your_openweather_api_key_here

# ── OSRM Routing API ───────────────────────────────────────────────────────────
# [OPTIONAL] Your own OSRM server (one that carries the car, foot and bike networks).
# If omitted, the backend uses the FOSSGIS community servers: routing.openstreetmap.de/routed-car, /routed-foot, /routed-bike.
# Do NOT point this at http://router.project-osrm.org: that demo server only knows the car network, so walking legs
# would come back at car speed and be drawn as straight lines (it is ignored if you do).
# OSRM_API_URL=

# ── Frontend URL (CORS) ────────────────────────────────────────────────────────
# Frontend origin for CORS (dev default)
FRONTEND_URL=http://localhost:5173
