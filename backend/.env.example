# TransitSwap Backend — Environment Configuration
# Copy this file to .env and fill in your values.
# All variables marked [OPTIONAL] will fall back to demo/mock data if not provided.

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=5000

# ── MongoDB ────────────────────────────────────────────────────────────────────
# [OPTIONAL] If not provided, the app will run fully offline using demo data.
MONGODB_URI=mongodb://localhost:27017/transitswap

# ── JSON Web Token ─────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# ── OpenWeatherMap API ─────────────────────────────────────────────────────────
# [OPTIONAL] Free tier key from https://openweathermap.org/api
# If omitted, the platform uses deterministic demo weather (clearly labelled "Demo").
OPENWEATHER_API_KEY=your_openweather_api_key_here

# ── Frontend URL (CORS) ────────────────────────────────────────────────────────
# Frontend origin for CORS (dev default)
FRONTEND_URL=http://localhost:5173

